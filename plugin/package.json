{
  "name": "@local/video-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Oak MCP video-editing studio: connects oak-mcp and previews exported cuts in the DSH Web GUI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "GPL-3.0-or-later"
}
