{
  "name": "@oakvideoeditor/oak-deepseek-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness video-studio plugin: connects the oak MCP server (Quercus engine) and previews/plays exported cuts in the GUI sidebar.",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "optionalDependencies": {
    "@oakvideoeditor/oak-mcp-darwin-arm64": "0.1.0",
    "@oakvideoeditor/oak-mcp-linux-x64": "0.1.0",
    "@oakvideoeditor/oak-mcp-win32-x64": "0.1.0"
  }
}
